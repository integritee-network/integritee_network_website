ientation, colour, disability, or place of origin. Let your experience speak for itself add full stop\r\n            </p>\r\n          </div>\r\n          <div class='join__links'>\r\n            <LineLink\r\n              text='Full-Stack Developer'\r\n              :link=\"FULL_STACK_DEV\"\r\n            />\r\n            <LineLink\r\n              text='Rust Core Developer'\r\n              :link=\"RUST_CORE_DEV\"\r\n            />\r\n            <LineLink\r\n              text='Senior DevOps Engineer'\r\n              :link=\"SENIOR_DEVOPS\"\r\n            />\r\n            <LineLink\r\n              text='View all positions'\r\n              :link=\"ALL_POSITION\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n</template>\r\n<script setup lang='ts'>\r\nimport LineLink from '@/components/Global/LineLink.vue'\r\nimport {\r\n  FULL_STACK_DEV,\r\n  RUST_CORE_DEV,\r\n  SENIOR_DEVOPS,\r\n  ALL_POSITION\r\n} from '@/configs/app.config';\r\n</script>\r\n<style lang=\"scss\">\r\n.join {\r\n  &__row {\r\n    @media screen and (max-width: 840px) {\r\n      display: block;\r\n    }\r\n  }\r\n\r\n  &__titleWrap {\r\n    width: 550px;\r\n\r\n    @media screen and (max-width: 1366px) {\r\n      width: 500px;\r\n    }\r\n\r\n    @media screen and (max-width: 1200px) {\r\n      width: 369px;\r\n    }\r\n\r\n    @media screen and (max-width: 840px) {\r\n      width: 100%;\r\n    }\r\n  }\r\n\r\n  &__text {\r\n    line-height: 150%;\r\n  }\r\n\r\n  &__links {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 32px;\r\n    width: 610px;\r\n\r\n    @media screen and (max-width: 1366px) {\r\n      width: 551px;\r\n    }\r\n\r\n    @media screen and (max-width: 1024px) {\r\n      width: 371px;\r\n    }\r\n\r\n    @media screen and (max-width: 840px) {\r\n      width: 100%;\r\n      margin-top: 24px;\r\n      gap: 24px;\r\n    }\r\n  }\r\n}</style>\r\n","import { objectEntries } from '@vueuse/core'\r\nimport map f