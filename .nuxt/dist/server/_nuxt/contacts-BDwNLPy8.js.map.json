GAAG,QAAO,CAAA,EAAI,cAAS;AAAA,IAAgC,QAAA,OAAA,SAAS,YAAO;AAAA,qIAIvDC,eAAA,OAAA,SAAS,OAAO,6BAEhFD,eAAA,CAAA,EAAA,QAAA,OAAA,SAAS,YAAO,GAAA,GAAA,8BAAA,CAAA,qGAEpC,OAAA,GAAG,QAAQ,cAAc,OAAA,GAAG,QAAO,CAAA,EAAI,QAAQ,mEAEvB,OAAA,SAAS,OAAA,SAAS,OAAO,CAAA,gJAGiB,KAAA,SAAS,IAAA,cAAA,6EAGzD,OAAA,UAAS,GAAA,eAAA,CAAA;;;;;;;;;;;ACpDjC,QAAA,OAAAF,eAAAC,WAAA,EAAA,OAAM,UAAM,MAAA,CAAA,CAAA,6DAAA;;;;;;;;;;;;;;;;;ACAZ,YAAA,OAAAD,eAAAC,WAAA,EAAA,OAAM,cAAU,MAAA,CAAA,CAAA,mBAAA;;QAEN,eAAX,CAIW,GAAAG,QAAAC,UAAA,aAAA;;;;;cAHTC,YAAkB,cAAZ,OAAK;AAAA,8BAAO,OAClB;AAAA,cAAAA,YAAqD,QAAA,EAA/C,OAAM,4BAA2B,GAAC,QAAM;AAAA,8BAAO,6DAEvD;AAAA;;;;;;;QAOmB,eAAX,CAKW,GAAAF,QAAAC,UAAA,aAAA;;;;;cAJTC,YAGK,MAAA,EAHD,OAAM,8BAA6B,GAAA;AAAA,gCAAC,eAC1B;AAAA,gBAAAA,YAAM,IAAA;AAAA,gCAAA,mBAEpB;AAAA;;;;QAES,eAAX,CA0BW,GAAAF,QAAAC,UAAA,aAAA;;;;;cAzBTC,YAwBM,OAAA,EAxBD,OAAM,YAAW,GAAA;AAAA,gBACpBA,YAeM,OAAA,EAfD,OAAM,aAAY,GAAA;AAAA,kBACrBA,YAA2C,OAAA,EAAtC,OAAM,8BAA6B,CAAA;AAAA,kBACxCA,YAAiD,KAAA,EAA9C,OAAM,0BAAyB,GAAC,YAAU;AAAA,kBAC7CA,YAWI,KAAA,EAXD,OAAM,kBAAiB,GAAA;AAAA,oBACxBA,YAIC,KAAA;AAAA,sBAHC,MAAK;AAAA,sBACL,OAAM;AAAA,uBACL,0BAAwB;AAAA,oBAE3BA,YAIC,KAAA;AAAA,sBAHC,MAAK;AAAA,sBACL,OAAM;AAAA,uBACL,4BAA0B;AAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;AC5BnD,gBAAY;AAAA,MACV,OAAO;AAAA,MACP,aAAa;AAAA,IAAA,CACd;;;;;;;;;;;;;","names":["_sfc_main","_ssrRenderAttrs","_mergeProps","_ssrRenderClass","_ssrInterpolate","_push","_parent","_createVNode"],"sources":["../../../../components/Contacts/Form.vue","../../../../components/Contacts/Info.vue","../../../../components/Contacts/index.vue","../../../../pages/contacts.vue"],"sourcesContent":["<template>\n  <form class=\"form\" @submit.prevent=\"onSubmit()\">\n    <div class=\"form__row row jcsb\">\n      <div class=\"form__field\" :class=\"{\n        error: v$.$errors.length > 0 && v$.$errors[0].$property === 'name',\n        active: formData.name !== '',\n      }\">\n        <input @input=\"onFieldChange('name', $event.target.value)\" :value=\"formData.name\" type=\"text\"\n          class=\"paragraph_medium form__input\" />\n        <label :class=\"{ active: formData.name !== '' }\" class=\"form__label paragraph_medium\">Name</label>\n        <div class=\"form__field_caption\">\n          {{ v$.$errors.length > 0 && v$.$errors[0].$message }}\n        </div>\n      </div>\n      <div class=\"form__field\" :class=\"{\n        error: v$.$errors.length > 0 && v$.$errors[0].$property === 'email',\n        active: formData.email !== '',\n      }\">\n        <input @input=\"onFieldChange('email', $event.target.value)\" :value=\"formData.email\" type=\"text\"\n          class=\"paragraph_medium form__input\" />\n        <label :class=\"{ active: formData.email !== '' }\" class=\"form__label paragraph_medium\">Email</label>\n        <div class=\"form__field_caption\">\n          {{ v$.$errors.length > 0 && v$.$errors[0].$message }}\n        </div>\n      </div>\n      <div class=\"form__field\" :class=\"{\n        error: v$.$errors.length > 0 && v$.$errors[0].$property === 'subject',\n        active: formData.subject !== '',\n      }\">\n        <input maxlength=\"80\" @input=\"onFieldChange('subject', $event.target.value)\" :value=\"formData.subject\" type=\"text\"\n          class=\"paragraph_medium form__input\" />\n        <label :class=\"{ active: formData.subject !== '' }\" class=\"form__label paragraph_medium\">Subject</label>\n        <div class=\"form__field_caption\">\n          {{ v$.$errors.length > 0 && v$.$errors[0].$message }}\n        </div>\n        <span class=\"form__count\">{{ getCount(formData.subject) }}/80</span>\n      </div>\n      <div class=\"form__field\" :class=\"{\n        error: v$.$errors.length > 0 && v$.$errors[0].$property === 'message',\n        active: formData.message !== '',\n      }\">\n        <textarea maxlength=\"200\" @input=\"onFieldChange('message', $event.target.value)\" :value=\"formData.message\"\n          class=\"paragraph_medium form__textarea scrollbar\" />\n        <label :class=\"{ active: formData.message !== '' }\" class=\"form__label paragraph_medium\">Message</label>\n        <div class=\"form__field_caption\">\n          {{ v$.$errors.length > 0 && v$.$errors[0].$message }}\n        </div>\n        <span class=\"form__count\">{{ getCount(formData.message) }}/200</span>\n      </div>\n      <div class=\"btn__row row\">\n        <button type=\"submit\" class=\"btn btn_gradient form__button\" :disabled=\"isSending\">\n          Submit\n        </button>\n        <div :class=\"{ active: isSuccess }\" class=\"form__success\">\n          <div class=\"form__success-icon\" />\n          <div class=\"form__success-text\">Form completed. Thanks!</div>\n          <div @click=\"onCloseHandler\" class=\"form__success-close\" />\n        </div>\n      </div>\n    </div>\n  </form>\n</template>\n\n<script>\nimport { ref } from 'vue'\nimport useVuelidate from '@vuelidate/core'\nimport { required, minLength, email, maxLength } from '@vuelidate/validators'\n\nexport default {\n  setup() {\n    const formData = ref({\n      name: '',\n      email: '',\n      subject: '',\n      message: '',\n    })\n\n    let isSuccess = ref(false)\n    let isSending = ref(false)\n\n    const rules = {\n      name: { required, minLength: minLength(2) },\n      email: { required, email },\n      subject: { required, minLength: minLength(2) },\n      message: { required, minLength: minLength(2) },\n    }\n\n    const v$ = useVuelidate(rules, formData)\n\n    const resetForm = () => {\n      formData.value = {\n        name: '',\n        email: '',\n        subject: '',\n        message: '',\n      }\n      v$.value.$reset()\n    }\n\n    const onSubmit = async () => {\n      const result = await v$.value.$validate()\n      if (result) {\n        isSending.value = true\n        try {\n          await $fetch('/api/mail', {\n            method: 'POST',\n            body: formData.value\n          })\n          resetForm()\n          isSuccess.value = true\n        } catch (err) {\n          console.log(err)\n        } finally {\n          isSending.value = false\n        }\n      }\n    }\n\n    const onCloseHandler = () => {\n      isSuccess.value = false\n    }\n\n    const getCount = (str) => {\n      return str.length\n    }\n\n    const onFieldChange = (propertyName, value) => {\n      formData.value = { ...formData.value, [propertyName]: value }\n    }\n\n    return {\n      formData,\n      isSuccess,\n      v$,\n      onSubmit,\n      onCloseHandler,\n      getCount,\n      onFieldChange,\n    }\n  },\n}\n</script>\n\n<style lang=\"scss\" scoped>\n.form {\n  padding: 60px;\n  width: 700px;\n  background: rgba(81, 81, 81, 0.246);\n  backdrop-filter: blur(38.335px);\n  border-radius: 24px;\n\n  @media screen and (max-width: 1366px) {\n    padding: 60px;\n    width: 600px;\n  }\n\n  @media screen and (max-width: 1200px) {\n    width: 540px;\n  }\n\n  @media screen and (max-width: 1024px) {\n    width: 100%;\n    margin-top: 48px;\n  }\n\n  @media screen and (max-width: 840px) {\n    padding: 40px;\n    margin-top: 32px;\n  }\n\n  &__row {\n    flex-wrap: wrap;\n  }\n\n  &__field {\n    position: relative;\n    margin-bottom: 86px;\n    width: 100%;\n    transition: 0.4s;\n    border-bottom: 1px solid rgba(255, 255, 255, 0.2);\n\n    @media screen and (max-width: 840px) {\n      margin-bottom: 76px;\n    }\n\n    &:nth-child(1),\n    &:nth-child(2) {\n      width: 274px;\n\n      @media screen and (max-width: 1366px) {\n        width: 224px;\n      }\n\n      @media screen and (max-width: 1200px) {\n        width: 100%;\n      }\n    }\n\n    &:last-child {\n      margin-bottom: 57px;\n\n      @media screen and (max-width: 840px) {\n        margin-bottom: 54px;\n      }\n    }\n\n    &_caption {\n      font-family: 'Inter';\n      width: 100%;\n      position: absolute;\n      top: 110%;\n      left: 0;\n      font-weight: 400;\n      font-size: 0.875rem;\n      line-height: 150%;\n      color: #e54f45;\n      opacity: 0;\n      transition: 0.4s;\n    }\n\n    &.error {\n      border-bottom: 1px solid rgba(229, 79, 69, 0.2);\n\n      input,\n      textarea {\n        color: #e54f45;\n      }\n\n      .form__field_caption {\n        opacity: 1;\n      }\n    }\n\n    &.active {\n      border-bottom: 1px solid rgba(255, 255, 255, 0.5);\n\n      input,\n      textarea {\n        color: #fff;\n      }\n    }\n\n    &:focus-within {\n      border-bottom: 1px solid rgba(255, 255, 255, 0.4);\n    }\n  }\n\n  &__label {\n    position: absolute;\n    bottom: 32px;\n    left: 0;\n    transition: 0.4s;\n    pointer-events: none;\n\n    @media screen and (max-width: 840px) {\n      bottom: 18px;\n    }\n\n    &.active {\n      bottom: calc(100% + 8px);\n      font-size: 14px;\n      opacity: 0.4;\n\n      @media screen and (max-width: 840px) {\n        bottom: calc(100% + 4px);\n        font-size: 12px;\n      }\n    }\n  }\n\n  &__input,\n  &__textarea {\n    width: 100%;\n    background: transparent;\n    padding-bottom: 32px;\n    border: 0;\n    outline: none;\n    color: #fff;\n\n    @media screen and (max-width: 840px) {\n      padding-bottom: 18px;\n    }\n\n    &:focus {\n      +label {\n        bottom: calc(100% + 8px);\n        font-size: 14px;\n        opacity: 0.4;\n\n        @media screen and (max-width: 840px) {\n          bottom: calc(100% + 4px);\n          font-size: 12px;\n        }\n      }\n    }\n  }\n\n  &__textarea {\n    height: 81px;\n    resize: none;\n\n    @media screen and (max-width: 1366px) {\n      height: 108px;\n    }\n\n    @media screen and (max-width: 840px) {\n      height: 63px;\n    }\n  }\n\n  button {\n    position: relative;\n    color: #fff;\n    border: 0;\n    outline: none;\n    cursor: pointer;\n  }\n\n  &__success {\n    position: relative;\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    padding: 8px 18px;\n    gap: 8px;\n    width: 267px;\n    height: 40px;\n    background: rgba(81, 81, 81, 0.8);\n    backdrop-filter: blur(35px);\n    border-radius: 12px;\n    margin-left: 18px;\n    transition: 0.4s;\n    opacity: 0;\n\n    @media screen and (max-width: 840px) {\n      position: absolute;\n      top: 50%;\n      left: 50%;\n      transform: translate(-50%, -50%);\n      padding: 9px 12px;\n      width: 222px;\n      height: 36px;\n      border-radius: 10px;\n      margin-left: 0;\n    }\n\n    &.active {\n      opacity: 1;\n    }\n  }\n\n  &__success-text {\n    font-family: 'Inter';\n    font-weight: 500;\n    font-size: 14px;\n    line-height: 150%;\n    color: #ffffff;\n    width: 170px;\n    text-align: center;\n\n    @media screen and (max-width: 840px) {\n      width: 146px;\n      font-size: 12px;\n    }\n  }\n\n  &__success-icon {\n    width: 21px;\n    height: 21px;\n    background: url('@/assets/img/contacts/success-icon.svg');\n    background-size: cover;\n\n    @media screen and (max-width: 840px) {\n      width: 18px;\n      height: 18px;\n    }\n  }\n\n  &__success-close {\n    width: 24px;\n    height: 24px;\n    background: url('@/assets/img/contacts/close-icon.svg');\n    background-size: cover;\n    cursor: pointer;\n\n    @media screen and (max-width: 840px) {\n      width: 18px;\n      height: 18px;\n    }\n  }\n\n  &__count {\n    position: absolute;\n    bottom: -25px;\n    right: 0;\n    font-family: 'Inter';\n    font-weight: 400;\n    font-size: 14px;\n    line-height: 150%;\n    text-align: right;\n    color: #ffffff;\n    opacity: 0.4;\n\n    @media screen and (max-width: 840px) {\n      bottom: -22px;\n      font-size: 12px;\n    }\n  }\n\n  &__button {\n    @media screen and (max-width: 840px) {\n      width: 100%;\n    }\n  }\n}\n\n.btn__row {\n  position: relative;\n  width: 100%;\n  align-items: center;\n}\n\n.scrollbar::-webkit-scrollbar {\n  width: 1px;\n}\n\n.scrollbar::-webkit-scrollbar-track {\n  background-color: rgba(255, 255, 255, 0.3);\n}\n\n.scrollbar::-webkit-scrollbar-thumb {\n  background-color: rgba(255, 255, 255, 1);\n}\n</style>\n","<template>\n  <div class='info'>\n    <div class='info__column'>\n      <slot name='title' />\n      <slot name='items' />\n    </div>\n  </div>\n</template>\n\n<script setup lang='ts'>\n</script>\n\n<style lang=\"scss\" scoped>\n.info {\n  width: 100%;\n  :slotted(.info__link) {\n    display: block;\n    line-height: 150%;\n    margin-bottom: 14px;\n\n    &:last-child {\n      margin-bottom: 0;\n    }\n  }\n\n  &__column {\n    width: 100%;\n  }\n\n  :slotted(.info__row) {\n    display: block;\n\n    @media screen and (max-width: 1024px) {\n      display: flex;\n    }\n\n    @media screen and (max-width: 420px) {\n      display: block;\n    }\n  }\n\n  :slotted(.info__icon) {\n    width: 48px;\n    height: 48px;\n    background: url(\"@/assets/img/contacts/contact.svg\");\n    background-size: cover;\n\n    @media screen and (max-width: 840px) {\n      width: 32px;\n      height: 32px;\n    }\n  }\n\n  :slotted(.contact__icon) {\n    width: 48px;\n    height: 48px;\n    background: url(\"@/assets/img/contacts/contact.svg\");\n    background-size: cover;\n    @media screen and (max-width: 840px) {\n      width: 32px;\n      height: 32px;\n    }\n  }\n\n  :slotted(.address__icon) {\n    width: 48px;\n    height: 48px;\n    background: url(\"@/assets/img/contacts/address-icon.svg\");\n    background-size: cover;\n    @media screen and (max-width: 840px) {\n      width: 32px;\n      height: 32px;\n    }\n  }\n\n  :slotted(.info__item) {\n    margin-bottom: 32px;\n\n    @media screen and (max-width: 1024px) {\n      width: 384px;\n      margin-bottom: 0;\n      margin-right: 32px;\n    }\n\n    @media screen and (max-width: 840px) {\n      width: 254px;\n    }\n\n    @media screen and (max-width: 420px) {\n      margin-bottom: 32px;\n      margin-right: 0;\n    }\n  }\n}\n</style>\n","<template>\n  <div class=\"contacts\">\n    <Desc>\n      <template #title>\n        <span>Build</span> and\n        <span class=\"text-gradient_purple-blue\">deploy</span> a new generation\n        of data-driven platforms with Integritee\n      </template>\n    </Desc>\n    <div class=\"block\">\n      <div class=\"container\">\n        <div class=\"contacts__row row jcsb\">\n          <div class=\"contacts__column\">\n            <Info>\n              <template #title>\n                <h2 class=\"title title_h2 margin_large\">\n                  Get in touch<br />\n                  with Integritee\n                </h2>\n              </template>\n              <template #items>\n                <div class=\"info__row\">\n                  <div class=\"info__item\">\n                    <div class=\"contact__icon margin_medium\" />\n                    <p class=\"title_sub margin_medium\">Contact Us</p>\n                    <p class=\"paragraph_large\">\n                      <a\n                        href=\"mailto: hello@integritee.network\"\n                        class=\"text-link info__link\"\n                        >hello@integritee.network</a\n                      >\n                      <a\n                        href=\"mailto: support@integritee.network\"\n                        class=\"text-link info__link\"\n                        >support@integritee.network</a\n                      >\n                    </p>\n                  </div>\n                  <!--<div class=\"info__item\">\n                    <div class=\"address__icon margin_medium\" />\n                    <p class=\"title_sub margin_medium\">Integritee AG</p>\n                    <p class=\"paragraph_large\">\n                      Technoparkstrasse 1, 8005 Zurich, Switzerland\n                    </p>\n                  </div>-->\n                </div>\n              </template>\n            </Info>\n          </div>\n          <Form />\n        </div>\n      </div>\n    </div>\n    <Socials />\n  </div>\n</template>\n\n<script setup>\nimport Form from '@/components/Contacts/Form.vue'\nimport Info from '@/components/Contacts/Info.vue'\nimport Desc from '@/components/Desc'\nimport Socials from '@/components/Socials/Section.vue'\n</script>\n<style lang=\"scss\" scoped>\n.contacts {\n  position: relative;\n\n  &__row {\n    @media screen and (max-width: 1024px) {\n      display: block;\n    }\n  }\n\n  &__column {\n    width: 500px;\n\n    @media screen and (max-width: 1200px) {\n      width: 350px;\n    }\n\n    @media screen and (max-width: 1024px) {\n      width: 100%;\n      br {\n        display: none;\n      }\n    }\n  }\n}\n</style>\n","<template lang=\"\">\n  <Contacts />\n</template>\n<script setup lang='ts'>\nimport { generateSEO } from '~/helpers/generateSEO'\n\ngenerateSEO({\n  title: 'Integritee Network - Contacts',\n  description: 'Build and deploy a new generation of data-driven platforms with Integritee. Get in touch with Integritee.'\n})\n</script>\n<style lang=\"\"></style>\n"],"version":3}